all:
  vars:
    ansible_user: your_username
    ansible_ssh_private_key_file: ~/.ssh/id_ed25519
  children:
    masters:
      hosts:
        master:
          ansible_host: YOUR_MASTER_IP
          network_interface: YOUR_MASTER_INTERFACE  # e.g. eno1, eno2, enp0s31f6
        master2:
          ansible_host: YOUR_MASTER2_IP
          network_interface: YOUR_MASTER2_INTERFACE
    workers:
      hosts:
        worker1:
          ansible_host: YOUR_WORKER1_IP
          network_interface: YOUR_WORKER1_INTERFACE
        worker2:
          ansible_host: YOUR_WORKER2_IP
          network_interface: YOUR_WORKER2_INTERFACE
